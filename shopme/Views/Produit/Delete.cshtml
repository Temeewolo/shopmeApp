@model shopme.Models.Produit

@{
    ViewData["Title"] = "Supprimer le produit";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow border-danger">

                <div class="card-header bg-danger text-white">

                    <h3 class="mb-0">
                        Supprimer le produit
                    </h3>

                </div>

                <div class="card-body">

                    <div class="text-center mb-4">

                        <h4>
                            Êtes-vous sûr de vouloir supprimer
                            ce produit ?
                        </h4>

                        <p class="text-muted">
                            Cette action est irréversible.
                        </p>

                    </div>


                    <div class="card bg-light mb-4">

                        <div class="card-body">

                            <h4 class="fw-bold">
                                @Model.NomProduit
                            </h4>

                            <p class="mb-1">
                                <strong>Code :</strong>
                                @Model.CodeProduit
                            </p>

                            <p class="mb-1">
                                <strong>Type :</strong>
                                @Model.TypeProduit
                            </p>

                            <p class="mb-0">
                                <strong>Prix :</strong>
                                @Model.PrixProduit.ToString("N0")
                                FCFA
                            </p>

                        </div>

                    </div>


                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="IdProduit" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger flex-fill">
                                Oui, supprimer
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary flex-fill">
                                Annuler
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>