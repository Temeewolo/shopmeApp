@model List<shopme.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-4 mb-5">

    <!-- TITRE -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                🔔 Notifications
            </h2>

            <p class="text-muted mb-0">
                Retrouvez ici toutes vos notifications.
            </p>

        </div>

    </div>


    @if (!Model.Any())
    {
        <!-- AUCUNE NOTIFICATION -->

        <div class="card shadow-sm border-0">

            <div class="card-body text-center p-5">

                <div style="font-size: 50px;">
                    🔔
                </div>

                <h4 class="mt-3">
                    Aucune notification
                </h4>

                <p class="text-muted">
                    Vous n'avez actuellement aucune notification.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- LISTE DES NOTIFICATIONS -->

        <div class="row">

            @foreach (var notification in Model)
            {
                <div class="col-12 mb-3">

                    <div class="card shadow-sm border-0">

                        <div class="card-body">

                            <div class="d-flex align-items-start">


                                <!-- ICÔNE -->

                                <div class="me-3">

                                    @if (notification.TypeNotification == "Commande")
                                    {
                                        <div class="rounded-circle
                                            bg-primary
                                            text-white
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:50px;height:50px;">

                                            🛒

                                        </div>
                                    }
                                    else if (notification.TypeNotification == "Promotion")
                                    {
                                        <div class="rounded-circle
                                            bg-warning
                                            text-dark
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:50px;height:50px;">

                                            🎉

                                        </div>
                                    }
                                    else if (notification.TypeNotification == "Bienvenue")
                                    {
                                        <div class="rounded-circle
                                            bg-success
                                            text-white
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:50px;height:50px;">

                                            👋

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-circle
                                            bg-secondary
                                            text-white
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:50px;height:50px;">

                                            🔔

                                        </div>
                                    }

                                </div>


                                <!-- CONTENU -->

                                <div class="flex-grow-1">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                        <h5 class="mb-1">

                                            @notification.TypeNotification

                                        </h5>

                                        <small class="text-muted">

                                            @notification.DateNptification.ToString(
                                                "dd/MM/yyyy HH:mm"
                                            )

                                        </small>

                                    </div>


                                    <p class="mb-2">

                                        @notification.MessageNotification

                                    </p>


                                    @if (notification.StatutNotification)
                                    {
                                        <span class="badge bg-success">
                                            Lu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Non lu
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>